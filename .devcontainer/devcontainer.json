{
  "name": "Qubeterra Climate Finance",
  "image": "mcr.microsoft.com/devcontainers/python:3.11",
  "features": {
    "ghcr.io/devcontainers/features/node:1": {
      "version": "18"
    }
  },
  "forwardPorts": [8000, 5173],
  "portsAttributes": {
    "8000": {
      "label": "Backend API",
      "onAutoForward": "notify"
    },
    "5173": {
      "label": "Frontend",
      "onAutoForward": "openPreview"
    }
  },
  "postCreateCommand": "pip install -r requirements.txt && pip install -r backend/requirements.txt && npm --prefix frontend ci",
  "remoteUser": "vscode"
}
